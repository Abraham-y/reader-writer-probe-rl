# Analysis artifacts (large or trivially reproducible)
extension/cache/
*.npz
*.pkl
*.csv

# extension/outputs/ is NOT excluded wholesale. The small .txt/.json result
# artifacts are the released evidence for the paper's numbers -- its
# reproducibility statement claims they regenerate from this repo, and that is
# only checkable if the files the analysis scripts write are here (~250 KB
# total). A blanket `extension/outputs/` rule stops git descending into the
# directory at all, so negations inside it never fire; exclude by kind instead.
extension/outputs/**/*.png
extension/outputs/**/*.pdf
extension/outputs/**/*.jsonl
extension/outputs/_smoke/
extension/outputs/n500/probe_behavioral/
extension/outputs/n500/probe_behavioral_1.5b/

# macOS
.DS_Store

# Personal/local Claude Code settings
.claude/

# === Paper ===
# InterpScience 2026 accepted the paper on 2026-09-29, so the blind-review rule
# that kept paper sources off the remote no longer applies. What is tracked:
# the camera-ready (writeup_interpscience.{tex,txt,pdf}) and everything it needs
# to build from a fresh clone -- the style file, the .bib and the two figures
# (regenerate those with scripts/plot_lag_from_gated.py and
# scripts/plot_ladder_from_gated.py). Earlier drafts were removed before release.
# Everything else LaTeX writes is ignored. Negations come after the rules they
# undo, and `figures/*` (not `figures/`) so that the negations can reach inside.
*.tex
*.pdf
*.aux
*.bbl
*.blg
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz
*.bib
*.cls
*.sty
figures/*
# ...and every nested figures/ directory, as the old `figures/` rule did
*/**/figures/
!writeup_interpscience.tex
!writeup_interpscience.pdf
!neurips_workshop.sty
!references.bib
!figures/lag.pdf
!figures/ladder.pdf

# Local-only material that was never in git (old course reports, submission
# zips, superseded PDFs). Kept on disk, never pushed.
_attic/

# huggingface_hub keeps download metadata here when fetching artifacts into place
.cache/

# Private research notes / writeups / runbooks (not for the public repo)
writeup.md
writeup_workshop.md
findings.md
RUNBOOK_CLEAN_REPLICATION.md
MEMORY.md
script.tex
memory/

# Large eval outputs (rebuild with extension/evaluation scripts)
eval_*.json
eval.json
causal_steering_*.jsonl
*.jsonl

