# Analysis artifacts (large or trivially reproducible)
extension/cache/
*.npz
*.pkl
*.csv

# extension/outputs/ is NOT excluded wholesale. The small .txt/.json result
# artifacts are the released evidence for the paper's numbers -- its
# reproducibility statement claims they regenerate from this repo, and that is
# only checkable if the files the analysis scripts write are here (~250 KB
# total). A blanket `extension/outputs/` rule stops git descending into the
# directory at all, so negations inside it never fire; exclude by kind instead.
extension/outputs/**/*.png
extension/outputs/**/*.pdf
extension/outputs/**/*.jsonl
extension/outputs/_smoke/
extension/outputs/n500/probe_behavioral/
extension/outputs/n500/probe_behavioral_1.5b/

# macOS
.DS_Store

# Personal/local Claude Code settings
.claude/

# === Paper artifacts (kept private; NEVER PUSH) ===
# The paper sources are tracked so the submissions are backed up, but this
# repo's remote is github.com/Abraham-y/... -- the owner name is an author
# name -- and writeup_workshop{,_full}.tex carry both real names. Pushing
# these while JUDGe review is open breaks the double-blind: a reviewer who
# finds the repo sees a named version of the anonymised submission.
# Keep them local until decisions are out.
*.tex
!writeup_judge.tex
!writeup_judge_short.tex
!writeup_judge_spotlight.tex
!writeup_workshop.tex
!writeup_workshop_full.tex
!writeup_judge_spotlight.md
!writeup_judge_shortpaper.tex
!writeup_judge_shortpaper.md
*.pdf
*.aux
*.bbl
*.blg
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz
*.bib
*.cls
*.sty
figures/

# Private research notes / writeups / runbooks (not for the public repo)
writeup.md
writeup_workshop.md
findings.md
RUNBOOK_CLEAN_REPLICATION.md
MEMORY.md
script.tex
memory/

